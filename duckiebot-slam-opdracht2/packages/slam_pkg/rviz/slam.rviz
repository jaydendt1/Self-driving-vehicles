Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Splitter Ratio: 0.5
    Tree Height: 549
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style: { Line Width: 0.03, Value: Lines }
      Name: Grid
      Normal Cell Count: 0
      Offset: { X: 0, Y: 0, Z: 0 }
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: map
      Value: true
    - Class: rviz/TF
      Enabled: true
      Marker Scale: 0.3
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
    - Alpha: 1
      Class: rviz/Odometry
      Color: 25; 255; 0
      Enabled: true
      Keep: 100
      Name: Odometry (raw)
      Shape: { Value: Arrow, Head Length: 0.1, Head Radius: 0.05, Shaft Length: 0.2, Shaft Radius: 0.02, Color: 25; 255; 0, Alpha: 1, Axes Length: 0.3, Axes Radius: 0.03 }
      Topic: /odometry/pose
      Value: true
    - Alpha: 1
      Class: rviz/Path
      Color: 0; 200; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.03
      Name: Fusion Path
      Pose Style: None
      Topic: /fusion_node/path
      Value: true
    - Alpha: 1
      Class: rviz/PoseArray
      Color: 255; 170; 0
      Enabled: true
      Name: Landmarks
      Shape: Sphere
      Topic: /slam_node/landmarks
      Value: true
    - Class: rviz/Image
      Enabled: true
      Image Topic: /slam_node/features/compressed
      Name: Camera + Features
      Queue Size: 2
      Transport Hint: compressed
      Value: true
    - Class: rviz/Image
      Enabled: true
      Image Topic: /slam_node/map/compressed
      Name: SLAM Map
      Queue Size: 2
      Transport Hint: compressed
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 5
      Focal Point: { X: 0, Y: 0, Z: 0 }
      Name: Current View
      Pitch: 1.4
      Target Frame: map
      Value: Orbit (rviz)
      Yaw: 0
